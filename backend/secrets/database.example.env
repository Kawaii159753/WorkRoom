# ==========================================
# 🗄️ SUPABASE POSTGRESQL DATABASE SECRETS (TEMPLATE)
# ==========================================
# Copy this file to `database.env` and fill in your actual credentials.

# Supabase Project Ref & Region
SUPABASE_PROJECT_REF="your-supabase-project-ref"
SUPABASE_REGION="ap-southeast-2"

# Transaction Pooler Connection (Port 6543 สำหรับรัน Backend API)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Session Pooler Connection (Port 5432 สำหรับรัน Prisma Migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Client API & Public Keys
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
