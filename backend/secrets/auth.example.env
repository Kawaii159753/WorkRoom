# ==========================================
# 🔐 AUTHENTICATION & JWT SECURITY SECRETS (TEMPLATE)
# ==========================================
# Copy this file to `auth.env` and fill in your actual credentials.

# JWT Signing Secret (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET="replace-with-at-least-32-random-characters-for-jwt"
JWT_EXPIRES_IN="7d"

# Cookie Signing Secret สำหรับ HttpOnly Cookies (อย่างน้อย 32 ตัวอักษร)
COOKIE_SECRET="replace-with-a-different-random-secret-for-cookies"
