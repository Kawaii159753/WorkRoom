{
  "name": "workroom-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for WorkRoom collaboration platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsc prisma/seed.ts --outDir dist-seed --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop --skipLibCheck && node dist-seed/seed.js",
    "db:local:start": "prisma dev --name workroom --detach",
    "db:local:stop": "prisma dev stop workroom",
    "lint": "eslint src --ext .ts",
    "test": "vitest run src"
  },
  "keywords": [
    "workroom",
    "backend",
    "typescript",
    "express",
    "prisma",
    "postgresql",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.5",
    "prisma": "6.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "argon2@0.40.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  }
}
