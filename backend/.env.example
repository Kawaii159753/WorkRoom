# ==============================================================================
# WorkRoom Backend Environment Configuration (Template)
# ==============================================================================
# NOTE: In WorkRoom, credentials and sensitive variables can be loaded from
# dedicated files in `backend/secrets/` (e.g. database.env, auth.env, app.env)
# or via an external directory pointed to by `WORKROOM_SECRETS_DIR`.
#
# Alternatively, you may copy this file to `.env` for local standalone setup.
# NEVER commit actual secrets, keys, or passwords to Git.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:8765,http://127.0.0.1:8765

# PostgreSQL Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workroom?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/workroom?schema=public"

# Authentication & Session Security (Min 32 characters each)
JWT_SECRET="replace-with-at-least-32-random-characters-for-jwt"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-different-random-secret-for-cookies"

# Supabase Client API & Public Keys (Optional)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Optional External Secrets Vault Directory (e.g., /path/to/vault or D:\Secrets)
# WORKROOM_SECRETS_DIR=""

# Development Seed Control (Never enable in production)
ALLOW_DEMO_SEED=false
