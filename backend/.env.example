PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:8765,http://127.0.0.1:8765

# PostgreSQL connection used by Prisma. For local development this can point
# to `prisma dev`; production must use its own managed PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workroom?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/workroom?schema=public

# Replace these values outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-different-random-secret
